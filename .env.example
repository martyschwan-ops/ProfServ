# ── Extraction provider ────────────────────────────────────────────────────────
# Options: mock | anthropic | openai
EXTRACTION_PROVIDER=mock

# Anthropic API key (required when EXTRACTION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI API key (required when EXTRACTION_PROVIDER=openai)
OPENAI_API_KEY=

# ── FX provider ────────────────────────────────────────────────────────────────
# Options: frankfurter | manual
FX_PROVIDER=frankfurter

# ── Paths (defaults work for most setups) ──────────────────────────────────────
DATA_DIR=data
RECEIPTS_DIR=receipts
WORKBOOK_NAME=expenses.xlsx
FX_CACHE_FILE=data/fx_cache.json

# ── Per-diem amounts (CAD) ──────────────────────────────────────────────────────
BREAKFAST_AMOUNT=20
LUNCH_AMOUNT=25
DINNER_AMOUNT=45
BASE_CURRENCY=CAD

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
